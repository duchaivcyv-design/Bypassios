<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "https://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Cho phép debug và gắn kết tiến trình -->
    <key>com.apple.security.get-task-allow</key>
    <true/>
    
    <!-- Quyền quản lý container dữ liệu ứng dụng -->
    <key>com.apple.private.security.storage.AppDataContainers</key>
    <true/>

    <!-- [BỔ SUNG] Vượt qua lớp kiểm tra mã lệnh của AMFI (Apple Mobile File Integrity) -->
    <key>com.apple.private.amfi.get-out-of-jail-free</key>
    <true/>

    <!-- [BỔ SUNG] Cho phép tiến trình bỏ qua các hạn chế về Sandbox hệ thống -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- [BỔ SUNG] Quyền truy cập và thao tác phân vùng tệp hệ thống cấp cao -->
    <key>com.apple.private.security.container-required</key>
    <false/>
</dict>
</plist>
